{
	"name": "self-improvement",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"test:unit": "vitest",
		"mobile:dev": "npm run dev",
		"mobile:build": "npm run build",
		"mobile:check": "npm run check",
		"mobile:test": "npm run test",
		"cap:sync": "npm run build && cap sync android",
		"cap:android": "npm run cap:sync && cap run android",
		"cap:android:open": "npm run cap:sync && cap open android",
		"mobile:sync": "npm run cap:sync",
		"mobile:android": "npm run cap:android",
		"mobile:android:open": "npm run cap:android:open"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@capacitor/cli": "^8.5.0",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.0",
		"@capacitor/local-notifications": "^8.3.1",
		"@capawesome/capacitor-file-picker": "^8.0.4",
		"@capgo/capacitor-android-usagestatsmanager": "^8.1.1",
		"@capgo/capacitor-health": "^8.10.3",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"dexie": "^4.4.5",
		"gsap": "^3.15.0",
		"mode-watcher": "^1.1.0",
		"zod": "^4.4.3"
	}
}
