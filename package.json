{
	"name": "self-improvement",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 3000",
		"build": "wrangler types --include-env=false --check && vite build",
		"deploy": "npm run build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "patch-package",
		"check": "wrangler types --include-env=false --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:web && npm run mobile:test",
		"test:web": "vitest --run --passWithNoTests",
		"test:unit": "vitest --passWithNoTests",
		"mobile:test": "vitest --config mobile/vitest.config.ts --run",
		"mobile:dev": "vite --config vite.mobile.config.ts",
		"mobile:build": "vite build --config vite.mobile.config.ts",
		"mobile:check": "svelte-check --workspace mobile --config ../vite.mobile.config.ts",
		"mobile:sync": "npm run mobile:build && cap sync android",
		"mobile:android": "npm run mobile:sync && cap run android",
		"mobile:android:open": "npm run mobile:sync && cap open android",
		"gen": "wrangler types --include-env=false",
		"auth:schema": "npx --yes auth@1.6.29 generate --config src/lib/server/auth.cli.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply self-improvement-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply self-improvement-db --remote",
		"db:setup": "npm run auth:schema && npm run db:generate && npm run db:migrate:local",
		"admin:create": "node scripts/create-admin.mjs",
		"admin:create:local": "node scripts/create-admin.mjs --local",
		"admin:create:remote": "node scripts/create-admin.mjs --remote"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@cloudflare/workers-types": "^5.20260817.1",
		"@eslint/js": "^10.0.1",
		"@iconify/svelte": "^5.2.2",
		"@inquirer/prompts": "^8.5.2",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"patch-package": "^8.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@better-auth/drizzle-adapter": "^1.6.29",
		"@capacitor-mlkit/barcode-scanning": "^8.1.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.0",
		"@capgo/capacitor-android-usagestatsmanager": "^8.1.1",
		"@capgo/capacitor-health": "^8.10.3",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"better-auth": "^1.6.29",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"qrcode": "^1.5.4",
		"zod": "^4.4.3"
	}
}
