{
	"name": "self-improvement",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run mobile:dev",
		"build": "npm run mobile:build",
		"prepare": "cd mobile && svelte-kit sync",
		"check": "npm run mobile:check",
		"check:watch": "cd mobile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run mobile:test",
		"test:unit": "cd mobile && vitest",
		"mobile:test": "cd mobile && vitest --run",
		"mobile:dev": "cd mobile && vite",
		"mobile:build": "cd mobile && vite build",
		"mobile:check": "cd mobile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"mobile:sync": "npm run mobile:build && cap sync android",
		"mobile:android": "npm run mobile:sync && cap run android",
		"mobile:android:open": "npm run mobile:sync && cap open android"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.0",
		"@capacitor/local-notifications": "^8.3.1",
		"@capawesome/capacitor-file-picker": "^8.0.4",
		"@capgo/capacitor-android-usagestatsmanager": "^8.1.1",
		"@capgo/capacitor-health": "^8.10.3",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"dexie": "^4.4.5",
		"gsap": "^3.15.0",
		"mode-watcher": "^1.1.0",
		"zod": "^4.4.3"
	}
}
