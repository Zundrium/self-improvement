{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "self-improvement",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"routes": [{ "pattern": "self.zund.cc", "custom_domain": true }],
	"vars": {
		"APP_URL": "https://self.zund.cc",
		"BETTER_AUTH_URL": "https://self.zund.cc",
		"BETTER_AUTH_TRUSTED_ORIGINS": "https://self.zund.cc"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "self-improvement-db",
			"database_id": "abe86f6f-e6b0-4b27-8862-c34e4dac662c",
			"migrations_dir": "drizzle"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
